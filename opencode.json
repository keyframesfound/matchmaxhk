{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "orchestrator",
  "experimental": {
    "full_codemode": true
  },
  "agents": {
    "title": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--storage-state",
        "/Users/ryanyeung/Developer/matchmaxhk/tests/e2e/.auth/user.json",
        "--browser",
        "chrome",
        "--headless",
        "--viewport-size",
        "1440x900",
        "--console-level",
        "error",
        "--output-dir",
        "/Users/ryanyeung/Developer/matchmaxhk/test-results/mcp"
      ]
    }
  }
}
